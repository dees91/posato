CREATE TABLE localApplicationMapping (
    setId BLOB NOT NULL,
    mappingId BLOB NOT NULL,
    displayName BLOB NOT NULL,
    designatedRequirement BLOB NOT NULL,
    PRIMARY KEY (setId, mappingId)
);

selectForSet:
SELECT mappingId, displayName, designatedRequirement
FROM localApplicationMapping
WHERE setId = ?
ORDER BY displayName, mappingId;

selectRequirements:
SELECT DISTINCT mappingId, designatedRequirement
FROM localApplicationMapping;

selectSetIds:
SELECT DISTINCT setId
FROM localApplicationMapping;

insertOrIgnore:
INSERT OR IGNORE INTO localApplicationMapping(setId, mappingId, displayName, designatedRequirement)
VALUES (?, ?, ?, ?);

removeById:
DELETE FROM localApplicationMapping
WHERE setId = ? AND mappingId = ?;

removeSet:
DELETE FROM localApplicationMapping
WHERE setId = ?;

countUnique:
SELECT COUNT(DISTINCT mappingId)
FROM localApplicationMapping;
