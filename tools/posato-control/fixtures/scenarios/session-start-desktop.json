{
  "version": 1,
  "launch": { "terminateExisting": true },
  "defaults": { "timeoutSeconds": 30 },
  "onFailure": { "screenshot": true, "snapshot": true },
  "steps": [
    { "name": "home-inactive", "action": "waitFor", "state": "exists", "query": { "text": "No session active" } },
    { "name": "open-paused-items", "action": "tap", "query": { "text": "Paused items", "role": "button" } },
    { "name": "targets-ready", "action": "waitFor", "state": "exists", "query": { "text": "Add website" } },
    { "name": "enter-domain", "action": "type", "query": { "role": "textField", "near": { "text": "Add website" } }, "text": "example.com", "clear": true },
    { "name": "submit-domain", "action": "tap", "query": { "text": "Add website", "role": "button" } },
    { "name": "row-visible", "action": "waitFor", "state": "exists", "query": { "text": "example.com", "role": "text" } },
    { "name": "open-session", "action": "tap", "query": { "text": "Session", "role": "button" } },
    { "name": "session-home", "action": "waitFor", "state": "exists", "query": { "text": "No session active" } },
    { "name": "begin-setup", "action": "tap", "query": { "text": "Start session", "role": "button" } },
    { "name": "setup-open", "action": "waitFor", "state": "exists", "query": { "text": "Session length" } },
    { "name": "focus-minutes", "action": "tap", "query": { "role": "textField", "near": { "text": "Session length" } } },
    { "name": "enter-minutes", "action": "type", "query": { "role": "textField", "near": { "text": "Session length" } }, "text": "30", "clear": true },
    { "name": "submit-minutes", "action": "press", "key": "return" },
    { "name": "continue-review", "action": "tap", "query": { "text": "Review session", "role": "button" } },
    { "name": "review-open", "action": "waitFor", "state": "exists", "query": { "text": "Review session" } },
    { "name": "review-lists-item", "action": "assert", "state": "exists", "query": { "text": "example.com", "role": "text" } },
    { "name": "start", "action": "tap", "query": { "text": "Start session", "role": "button" } },
    { "name": "active", "action": "waitFor", "state": "exists", "query": { "text": "End session early", "role": "button" } },
    { "name": "active-shot", "action": "screenshot" },
    { "name": "active-tree", "action": "snapshot" }
  ]
}
