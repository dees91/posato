{
  "version": 1,
  "launch": {"terminateExisting":true},
  "defaults": {"timeoutSeconds":30},
  "onFailure": {"screenshot":true,"snapshot":true},
  "steps": [
    {"name":"ready","action":"waitFor","state":"exists","query":{"text":"Session","role":"button"}},
    {"name":"open-session","action":"tap","query":{"text":"Session","role":"button"}},
    {"name":"open-licenses-about","action":"tap","query":{"text":"About Posato","role":"button"}},
    {"name":"open-licenses-version","action":"waitFor","state":"exists","query":{"textContains":"Version ","role":"text"}},
    {"name":"open-licenses-about-shot","action":"screenshot"},
    {"name":"open-licenses-about-tree","action":"snapshot"},
    {"name":"open-licenses","action":"tap","query":{"textContains":"Licenses","role":"button"}},
    {"name":"licenses-list","action":"screenshot"},
    {"name":"license-open","action":"tap","query":{"text":"License","role":"button"}},
    {"name":"license-first","action":"waitFor","state":"exists","query":{"textContains":"Apache License\n                           Version 2.0, January 2004\n                        http://www.apache.org/licenses/","role":"text"}},
    {"name":"license-start","action":"screenshot"},
    {"name":"license-tree","action":"snapshot"},
    {"name":"license-section-0","action":"scrollTo","query":{"textContains":"2. Grant of Copyright License.","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"license-section-1","action":"scrollTo","query":{"textContains":"4. Redistribution.","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"license-section-2","action":"scrollTo","query":{"textContains":"7. Disclaimer of Warranty.","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"license-section-3","action":"scrollTo","query":{"textContains":"END OF TERMS AND CONDITIONS","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"license-end","action":"scrollTo","query":{"textContains":"limitations under the License.","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"license-end-shot","action":"screenshot"},
    {"name":"license-end-tree","action":"snapshot"},
    {"name":"license-back","action":"tap","query":{"text":"Back to licenses","role":"button"}},
    {"name":"notice-open","action":"tap","query":{"text":"Notice","role":"button"}},
    {"name":"notice-first","action":"waitFor","state":"exists","query":{"textContains":"Posato\nCopyright 2026 Piotr Krawczyk and Posato contributors","role":"text"}},
    {"name":"notice-start","action":"screenshot"},
    {"name":"notice-tree","action":"snapshot"},
    {"name":"notice-end","action":"scrollTo","query":{"textContains":"Posato applications are built with third-party components that carry their\nown licenses and notices. They are listed in THIRD_PARTY_NOTICES.md.","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"notice-end-shot","action":"screenshot"},
    {"name":"notice-end-tree","action":"snapshot"},
    {"name":"notice-back","action":"tap","query":{"text":"Back to licenses","role":"button"}},
    {"name":"third-party-open","action":"tap","query":{"text":"Third-party notices","role":"button"}},
    {"name":"third-party-first","action":"waitFor","state":"exists","query":{"textContains":"Posato's source code is licensed under the Apache License, Version 2.0."}},
    {"name":"third-party-start","action":"screenshot"},
    {"name":"third-party-tree","action":"snapshot"},
    {"name":"third-party-license-link","action":"tap","query":{"text":"Read Apache License, Version 2.0","role":"button"}},
    {"name":"linked-license-ready","action":"waitFor","state":"exists","query":{"textContains":"Version 2.0, January 2004"}},
    {"name":"linked-license-shot","action":"screenshot"},
    {"name":"linked-license-back","action":"tap","query":{"text":"Back to licenses","role":"button"}},
    {"name":"third-party-reopen","action":"tap","query":{"text":"Third-party notices","role":"button"}},
    {"name":"third-party-components","action":"scrollTo","query":{"textContains":"Markdown parser (JetBrains)","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"third-party-table-shot","action":"screenshot"},
    {"name":"third-party-table-tree","action":"snapshot"},
    {"name":"third-party-attributions","action":"scrollTo","query":{"textContains":"Copyright Omar Aljarrah.","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"third-party-attributions-shot","action":"screenshot"},
    {"name":"third-party-attributions-tree","action":"snapshot"},
    {"name":"third-party-end","action":"scrollTo","query":{"textContains":"These tools are used to build or check Posato and are not shipped inside the applications: Gradle and its wrapper (Apache-2.0), the Kotlin and Compose Gradle plugins (Apache-2.0), Detekt and ktlint with Compose rules (Apache-2.0 and MIT), Clikt and SLF4J for the verification tools (Apache-2.0 and MIT), and SwiftLint build plugins (MIT).","role":"text","within":{"text":"Document text","role":"group"}},"timeoutSeconds":60},
    {"name":"third-party-end-shot","action":"screenshot"},
    {"name":"third-party-end-tree","action":"snapshot"},
    {"name":"third-party-back","action":"tap","query":{"text":"Back to licenses","role":"button"}},
    {"name":"return-session-about","action":"tap","query":{"text":"Back to About Posato","role":"button"}},
    {"name":"return-session","action":"tap","query":{"text":"Back","role":"button"}},
    {"name":"session-restored","action":"waitFor","state":"exists","query":{"text":"NO SESSION ACTIVE","role":"text"}},
    {"name":"open-items","action":"tap","query":{"text":"Paused items","role":"button"}},
    {"name":"items-ready","action":"waitFor","state":"exists","query":{"text":"Search","role":"button"}},
    {"name":"licenses-from-items-about","action":"tap","query":{"text":"About Posato","role":"button"}},
    {"name":"licenses-from-items-version","action":"waitFor","state":"exists","query":{"textContains":"Version ","role":"text"}},
    {"name":"licenses-from-items-about-shot","action":"screenshot"},
    {"name":"licenses-from-items-about-tree","action":"snapshot"},
    {"name":"licenses-from-items","action":"tap","query":{"textContains":"Licenses","role":"button"}},
    {"name":"return-items-about","action":"tap","query":{"text":"Back to About Posato","role":"button"}},
    {"name":"return-items","action":"tap","query":{"text":"Back","role":"button"}},
    {"name":"items-restored","action":"waitFor","state":"exists","query":{"text":"Search","role":"button"}},
    {"name":"return-proof","action":"snapshot"}
  ]
}
