{
  "version": 1,
  "launch": { "terminateExisting": true },
  "defaults": { "timeoutSeconds": 30 },
  "onFailure": { "screenshot": true, "snapshot": true },
  "steps": [
    { "name": "ready", "action": "waitFor", "state": "exists", "query": { "text": "Paused items", "role": "button" } },
    { "name": "home-inactive", "action": "waitFor", "state": "exists", "query": { "text": "NO SESSION ACTIVE" } },
    { "name": "begin-setup", "action": "tap", "query": { "text": "Start a session", "role": "button" } },
    { "name": "setup-open", "action": "waitFor", "state": "exists", "query": { "text": "YOUR NEXT PAUSE" } },
    { "name": "preset", "action": "tap", "query": { "text": "25 min", "role": "button" } },
    { "name": "continue-review", "action": "tap", "query": { "text": "Review session", "role": "button" } },
    { "name": "review-open", "action": "waitFor", "state": "exists", "query": { "text": "ONE LAST LOOK" } },
    { "name": "start", "action": "tap", "query": { "text": "Start this pause", "role": "button" } },
    { "name": "active", "action": "waitFor", "state": "exists", "query": { "text": "End session early", "role": "button" } },
    { "name": "open-app-before", "action": "launchApp", "bundleId": "com.apple.calculator" },
    { "name": "app-shielded-before", "action": "waitFor", "state": "exists", "query": { "scope": "springboard", "textContains": "You cannot use Calculator" } },
    { "name": "return-before", "action": "launchApp", "bundleId": "app.posato.ios" },
    { "name": "fast-relaunch", "action": "relaunch" },
    { "name": "active-after-fast-relaunch", "action": "waitFor", "state": "exists", "query": { "text": "End session early", "role": "button" } },
    { "name": "second-relaunch", "action": "relaunch" },
    { "name": "second-settle", "action": "sleep", "seconds": 5 },
    { "name": "active-after-second-relaunch", "action": "waitFor", "state": "exists", "query": { "text": "End session early", "role": "button" } },
    { "name": "third-relaunch", "action": "relaunch" },
    { "name": "callback-window", "action": "sleep", "seconds": 120 },
    { "name": "active-after-callback-window", "action": "waitFor", "state": "exists", "query": { "text": "End session early", "role": "button" } },
    { "name": "open-app-after", "action": "launchApp", "bundleId": "com.apple.calculator" },
    { "name": "app-shielded-after", "action": "waitFor", "state": "exists", "query": { "scope": "springboard", "textContains": "You cannot use Calculator" } },
    { "name": "open-site-after", "action": "openURL", "url": "http://example.com/" },
    { "name": "site-blocked-after", "action": "waitFor", "state": "exists", "timeoutSeconds": 45, "query": { "scope": "com.apple.mobilesafari", "text": "Website Not Allowed" } },
    { "name": "return-after", "action": "launchApp", "bundleId": "app.posato.ios" },
    { "name": "request-early-end", "action": "tap", "query": { "text": "End session early", "role": "button" } },
    { "name": "confirm-open", "action": "waitFor", "state": "exists", "query": { "text": "Ready to return?" } },
    { "name": "confirm-end", "action": "tap", "query": { "text": "End session", "role": "button" } },
    { "name": "inactive-again", "action": "waitFor", "state": "exists", "query": { "text": "NO SESSION ACTIVE" } }
  ]
}
