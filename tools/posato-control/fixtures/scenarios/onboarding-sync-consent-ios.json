{
  "version": 1,
  "launch": {
    "terminateExisting": false
  },
  "defaults": {
    "timeoutSeconds": 20
  },
  "onFailure": {
    "screenshot": true,
    "snapshot": true
  },
  "steps": [
    {
      "name": "purpose",
      "action": "tap",
      "query": {
        "text": "Make some space",
        "role": "button"
      },
      "timeoutSeconds": 30
    },
    {
      "name": "privacy-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "privacy-continue",
      "action": "tap",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "icloud-consent",
      "action": "tap",
      "query": {
        "text": "Sync with iCloud",
        "role": "button"
      }
    },
    {
      "name": "icloud-done",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "textContains": "completed its latest sync attempt"
      },
      "timeoutSeconds": 120
    },
    {
      "name": "icloud-continue",
      "action": "tap",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "request",
      "action": "tap",
      "query": {
        "text": "Allow Screen Time access",
        "role": "button"
      }
    },
    {
      "name": "system-continue",
      "action": "tap",
      "query": {
        "scope": "springboard",
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "system-allow",
      "action": "tap",
      "query": {
        "scope": "springboard",
        "textContains": "Allow with",
        "role": "button"
      }
    },
    {
      "name": "face-id-retry",
      "action": "tap",
      "optional": true,
      "timeoutSeconds": 8,
      "query": {
        "scope": "springboard",
        "id": "com.apple.localauthentication.ax.authentication.button.try-again"
      }
    },
    {
      "name": "face-id-fallback",
      "action": "tap",
      "optional": true,
      "timeoutSeconds": 8,
      "query": {
        "scope": "springboard",
        "id": "com.apple.localauthentication.ax.authentication.button.fallback"
      }
    },
    {
      "name": "passcode",
      "action": "pressKeys",
      "secret": "devicePasscode",
      "timeoutSeconds": 10
    },
    {
      "name": "system-done",
      "action": "tap",
      "query": {
        "scope": "springboard",
        "text": "Done",
        "role": "button"
      }
    },
    {
      "name": "allowed",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Screen Time access allowed"
      },
      "timeoutSeconds": 20
    },
    {
      "name": "permission-continue",
      "action": "tap",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "website-skip-reveal",
      "action": "scrollTo",
      "optional": true,
      "timeoutSeconds": 5,
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "website-skip",
      "action": "tap",
      "optional": true,
      "timeoutSeconds": 5,
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "website-continue",
      "action": "tap",
      "optional": true,
      "timeoutSeconds": 5,
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "summary",
      "action": "tap",
      "query": {
        "text": "Go to Session",
        "role": "button"
      }
    },
    {
      "name": "session-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Paused items",
        "role": "button"
      },
      "timeoutSeconds": 30
    },
    {
      "name": "session-shot",
      "action": "screenshot"
    }
  ]
}