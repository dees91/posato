{
  "version": 1,
  "launch": { "terminateExisting": true },
  "onFailure": { "screenshot": true, "snapshot": true },
  "steps": [
    { "action": "tap", "query": { "text": "Paused items", "role": "button" } },
    { "action": "type", "query": { "role": "textField" }, "text": "edit-proof.example", "clear": true, "submit": true },
    { "action": "tap", "query": { "text": "Done", "role": "button" } },
    { "action": "tap", "query": { "text": "Actions for edit-proof.example", "role": "button" } },
    { "action": "tap", "query": { "text": "Edit", "role": "button" } },
    { "action": "type", "query": { "role": "textField" }, "text": "changed-proof.example", "clear": true },
    { "action": "assert", "state": "exists", "query": { "text": "Save changes", "role": "button" } },
    { "action": "screenshot", "name": "editor-keyboard-visible" },
    { "action": "tap", "query": { "text": "Done", "role": "button" } },
    { "action": "tap", "query": { "text": "Session", "role": "button" } },
    { "action": "tap", "query": { "text": "Paused items", "role": "button" } },
    { "action": "assert", "state": "exists", "query": { "role": "textField", "text": "changed-proof.example" } },
    { "action": "tap", "query": { "text": "Cancel", "role": "button" } },
    { "action": "tap", "query": { "text": "Actions for edit-proof.example", "role": "button" } },
    { "action": "tap", "query": { "text": "Edit", "role": "button" } },
    { "action": "type", "query": { "role": "textField" }, "text": "changed-proof.example", "clear": true },
    { "action": "tap", "query": { "text": "Save changes", "role": "button" } },
    { "action": "tap", "query": { "text": "Done", "role": "button" } },
    { "action": "waitFor", "state": "exists", "query": { "text": "changed-proof.example", "role": "text" } },
    { "action": "relaunch" },
    { "action": "tap", "query": { "text": "Paused items", "role": "button" } },
    { "action": "waitFor", "state": "exists", "query": { "text": "changed-proof.example", "role": "text" } },
    { "action": "screenshot", "name": "edited-website-after-restart" },
    { "action": "snapshot", "name": "edited-website-after-restart" },
    { "action": "tap", "query": { "text": "Actions for changed-proof.example", "role": "button" } },
    { "action": "tap", "query": { "text": "Remove", "role": "button" } },
    { "action": "waitFor", "state": "absent", "query": { "text": "changed-proof.example", "role": "text" } },
    { "action": "tap", "query": { "text": "Actions for www.edit-proof.example", "role": "button" } },
    { "action": "tap", "query": { "text": "Remove", "role": "button" } },
    { "action": "waitFor", "state": "absent", "query": { "text": "www.edit-proof.example", "role": "text" } },
    { "action": "relaunch" },
    { "action": "tap", "query": { "text": "Paused items", "role": "button" } },
    { "action": "assert", "state": "absent", "query": { "text": "changed-proof.example", "role": "text" } },
    { "action": "assert", "state": "absent", "query": { "text": "edit-proof.example", "role": "text" } },
    { "action": "assert", "state": "absent", "query": { "text": "www.edit-proof.example", "role": "text" } },
    { "action": "snapshot", "name": "editor-fixtures-removed" }
  ]
}
