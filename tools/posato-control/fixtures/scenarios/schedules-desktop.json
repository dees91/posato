{
  "version": 1,
  "launch": {
    "terminateExisting": false
  },
  "defaults": {
    "timeoutSeconds": 30
  },
  "onFailure": {
    "screenshot": true,
    "snapshot": true
  },
  "steps": [
    {
      "name": "open-schedules",
      "action": "tap",
      "query": {
        "text": "Schedules",
        "role": "button"
      }
    },
    {
      "name": "empty-ready",
      "action": "waitFor",
      "query": {
        "text": "Add schedule",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "schedules-empty",
      "action": "screenshot"
    },
    {
      "name": "open-editor",
      "action": "tap",
      "query": {
        "text": "Add schedule",
        "role": "button"
      }
    },
    {
      "name": "editor-ready",
      "action": "waitFor",
      "query": {
        "role": "textField"
      },
      "state": "exists"
    },
    {
      "name": "name-empty-save",
      "action": "scrollTo",
      "query": {
        "text": "Save schedule",
        "role": "button"
      }
    },
    {
      "name": "refuse-empty-name",
      "action": "tap",
      "query": {
        "text": "Save schedule",
        "role": "button"
      }
    },
    {
      "name": "name-error",
      "action": "waitFor",
      "query": {
        "textContains": "Give the schedule a name"
      },
      "state": "exists"
    },
    {
      "name": "enter-name",
      "action": "type",
      "query": {
        "role": "textField"
      },
      "text": "Morning focus",
      "clear": true,
      "submit": true
    },
    {
      "name": "start-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Starts 09:00",
        "role": "button"
      }
    },
    {
      "name": "start-open",
      "action": "tap",
      "query": {
        "text": "Starts 09:00",
        "role": "button"
      }
    },
    {
      "name": "start-hour-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Increase Start hours"
      }
    },
    {
      "name": "start-hour-up",
      "action": "tap",
      "query": {
        "text": "Increase Start hours"
      }
    },
    {
      "name": "start-done-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Done",
        "role": "button"
      }
    },
    {
      "name": "start-done",
      "action": "tap",
      "query": {
        "text": "Done",
        "role": "button"
      }
    },
    {
      "name": "start-changed",
      "action": "waitFor",
      "query": {
        "text": "Starts 10:00",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "schedule-editor",
      "action": "screenshot"
    },
    {
      "name": "save-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Save schedule",
        "role": "button"
      }
    },
    {
      "name": "save",
      "action": "tap",
      "query": {
        "text": "Save schedule",
        "role": "button"
      }
    },
    {
      "name": "row-ready",
      "action": "waitFor",
      "query": {
        "text": "Actions for Morning focus",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "next-run-shown",
      "action": "waitFor",
      "query": {
        "textContains": "Next: "
      },
      "state": "exists"
    },
    {
      "name": "schedule-saved",
      "action": "screenshot"
    },
    {
      "name": "skip-menu",
      "action": "tap",
      "query": {
        "text": "Actions for Morning focus",
        "role": "button"
      }
    },
    {
      "name": "skip",
      "action": "tap",
      "query": {
        "text": "Skip next",
        "role": "button"
      }
    },
    {
      "name": "skip-shown",
      "action": "waitFor",
      "query": {
        "textContains": "Skipped: "
      },
      "state": "exists"
    },
    {
      "name": "schedule-skipped",
      "action": "screenshot"
    },
    {
      "name": "edit-menu",
      "action": "tap",
      "query": {
        "text": "Actions for Morning focus",
        "role": "button"
      }
    },
    {
      "name": "edit-open",
      "action": "tap",
      "query": {
        "text": "Edit",
        "role": "button"
      }
    },
    {
      "name": "edit-ready",
      "action": "waitFor",
      "query": {
        "text": "Edit schedule"
      },
      "state": "exists"
    },
    {
      "name": "rename",
      "action": "type",
      "query": {
        "role": "textField"
      },
      "text": "Evening focus",
      "clear": true,
      "submit": true
    },
    {
      "name": "off-reveal",
      "action": "scrollTo",
      "query": {
        "textContains": "Schedule on,",
        "role": "button"
      }
    },
    {
      "name": "turn-off",
      "action": "tap",
      "query": {
        "textContains": "Schedule on,",
        "role": "button"
      }
    },
    {
      "name": "rename-save-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Save schedule",
        "role": "button"
      }
    },
    {
      "name": "rename-save",
      "action": "tap",
      "query": {
        "text": "Save schedule",
        "role": "button"
      }
    },
    {
      "name": "renamed",
      "action": "waitFor",
      "query": {
        "text": "Actions for Evening focus",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "turned-off",
      "action": "waitFor",
      "query": {
        "textContains": "Turned off"
      },
      "state": "exists"
    },
    {
      "name": "old-name-gone",
      "action": "assert",
      "query": {
        "text": "Actions for Morning focus",
        "role": "button"
      },
      "state": "absent"
    },
    {
      "name": "schedule-off",
      "action": "screenshot"
    },
    {
      "name": "relaunch",
      "action": "relaunch"
    },
    {
      "name": "reopen-schedules",
      "action": "tap",
      "query": {
        "text": "Schedules",
        "role": "button"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "persisted",
      "action": "waitFor",
      "query": {
        "text": "Actions for Evening focus",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "delete-menu",
      "action": "tap",
      "query": {
        "text": "Actions for Evening focus",
        "role": "button"
      }
    },
    {
      "name": "delete-ask",
      "action": "tap",
      "query": {
        "text": "Delete",
        "role": "button"
      }
    },
    {
      "name": "delete-ask-settle",
      "action": "sleep",
      "seconds": 1
    },
    {
      "name": "delete-question",
      "action": "waitFor",
      "query": {
        "textContains": "It is deleted on your other devices too."
      },
      "state": "exists"
    },
    {
      "name": "delete-confirm-shot",
      "action": "screenshot"
    },
    {
      "name": "delete-keep",
      "action": "tap",
      "query": {
        "text": "Keep",
        "role": "button"
      }
    },
    {
      "name": "kept",
      "action": "waitFor",
      "query": {
        "text": "Actions for Evening focus",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "delete-menu-again",
      "action": "tap",
      "query": {
        "text": "Actions for Evening focus",
        "role": "button"
      }
    },
    {
      "name": "delete-ask-again",
      "action": "tap",
      "query": {
        "text": "Delete",
        "role": "button"
      }
    },
    {
      "name": "delete-ask-again-settle",
      "action": "sleep",
      "seconds": 1
    },
    {
      "name": "delete-question-again",
      "action": "waitFor",
      "query": {
        "text": "Keep",
        "role": "button"
      },
      "state": "exists"
    },
    {
      "name": "delete-confirm",
      "action": "tap",
      "query": {
        "text": "Delete",
        "role": "button",
        "near": {
          "text": "Keep",
          "role": "button"
        }
      }
    },
    {
      "name": "deleted",
      "action": "waitFor",
      "query": {
        "text": "Actions for Evening focus",
        "role": "button"
      },
      "state": "absent"
    },
    {
      "name": "empty-again",
      "action": "waitFor",
      "query": {
        "text": "Make time for a regular pause."
      },
      "state": "exists"
    },
    {
      "name": "schedules-final",
      "action": "screenshot"
    }
  ]
}
