{
  "version": 1,
  "launch": { "terminateExisting": false },
  "defaults": { "timeoutSeconds": 20 },
  "onFailure": { "screenshot": true, "snapshot": true },
  "steps": [
    { "name": "purpose-ready", "action": "waitFor", "state": "exists", "query": { "text": "Make some space", "role": "button" }, "timeoutSeconds": 30 },
    { "name": "purpose-continue", "action": "tap", "query": { "text": "Make some space", "role": "button" } },
    { "name": "privacy-reveal", "action": "scrollTo", "query": { "text": "Continue", "role": "button" } },
    { "name": "privacy-continue", "action": "tap", "query": { "text": "Continue", "role": "button" } },
    { "name": "icloud-consent", "action": "tap", "query": { "text": "Sync with iCloud", "role": "button" } },
    { "name": "icloud-done", "action": "waitFor", "state": "exists", "query": { "textContains": "completed its latest sync attempt" }, "timeoutSeconds": 120 },
    { "name": "icloud-continue", "action": "tap", "query": { "text": "Continue", "role": "button" } },
    { "name": "helper-enable", "action": "tap", "query": { "text": "Enable on this Mac", "role": "button" } },
    { "name": "helper-needs-approval", "action": "waitFor", "state": "exists", "query": { "text": "Open System Settings", "role": "button" }, "timeoutSeconds": 30 },
    { "name": "helper-settings", "action": "tap", "query": { "text": "Open System Settings", "role": "button" } }
  ]
}
