{
  "version": 1,
  "launch": {"terminateExisting": false},
  "defaults": {"timeoutSeconds": 30},
  "onFailure": {"screenshot": true, "snapshot": true},
  "steps": [
    {"name":"purpose-ready","action":"waitFor","state":"exists","query":{"text":"Make some space","role":"button"}},
    {"name":"purpose-continue","action":"tap","query":{"text":"Make some space","role":"button"}},
    {"name":"privacy-ready","action":"waitFor","state":"exists","query":{"text":"Your choices stay yours."}},
    {"name":"privacy-reveal","action":"scrollTo","query":{"text":"Continue","role":"button"},"timeoutSeconds":60},
    {"name":"privacy-continue","action":"tap","query":{"text":"Continue","role":"button"}},
    {"name":"icloud-ready","action":"waitFor","state":"exists","query":{"text":"Not now","role":"button"}},
    {"name":"icloud-decline","action":"tap","query":{"text":"Not now","role":"button"}},
    {"name":"permission-ready","action":"waitFor","state":"exists","query":{"text":"Nothing is paused until you start a session."}},
    {"name":"permission-defer","action":"tap","query":{"text":"Not now","role":"button"}},
    {"name":"website-ready","action":"waitFor","state":"exists","query":{"role":"textField"}},
    {"name":"website-reveal","action":"scrollTo","query":{"text":"Not now","role":"button"},"timeoutSeconds":60},
    {"name":"website-skip","action":"tap","query":{"text":"Not now","role":"button"}},
    {"name":"summary-ready","action":"waitFor","state":"exists","query":{"text":"Go to Session","role":"button"}},
    {"name":"summary-open-session","action":"tap","query":{"text":"Go to Session","role":"button"}},
    {"name":"session-ready","action":"waitFor","state":"exists","query":{"text":"Paused items","role":"button"}}
  ]
}
