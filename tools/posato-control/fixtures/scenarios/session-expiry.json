{
  "version": 1,
  "launch": {
    "terminateExisting": false
  },
  "defaults": {
    "timeoutSeconds": 30
  },
  "onFailure": {
    "screenshot": true,
    "snapshot": true
  },
  "steps": [
    {"name":"open-session","action":"tap","query":{"text":"Session","role":"button"}},
    {"name":"home-inactive","action":"precondition","state":"exists","query":{"text":"No session active"},"text":"End the active session first, for example with session-early-end.json."},
    {"name":"begin-setup","action":"tap","query":{"text":"Start a session","role":"button"}},
    {"name":"reveal-review","action":"scrollTo","query":{"text":"Review session","role":"button"}},
    {"name":"preset","action":"tap","query":{"text":"25 minutes","role":"button"}},
    {"name":"five-minutes","action":"adjustWheels","values":["0","5"]},
    {"name":"continue-review","action":"tap","query":{"text":"Review session","role":"button"}},
    {"name":"start","action":"tap","query":{"text":"Start this pause","role":"button"}},
    {"name":"active","action":"waitFor","state":"exists","query":{"text":"End session early","role":"button"}},
    {"name":"natural-expiry","action":"waitFor","state":"exists","query":{"text":"No session active"},"timeoutSeconds":400},
    {"name":"expired-shot","action":"screenshot"},
    {"name":"expired-tree","action":"snapshot"},
    {"name":"open-paused-items","action":"tap","query":{"text":"Pause sets","role":"button"}},
    {"name":"open-first-set","action":"tap","query":{"textContains":"My set","role":"button"}},
    {"name":"entry-ready","action":"waitFor","state":"exists","query":{"text":"Search","role":"button"}},
    {"name":"reach-row","action":"scrollTo","query":{"text":"example.com","role":"text","within":{"text":"Saved websites","role":"group"}}},
    {"name":"swipe-row","action":"swipeLeft","query":{"text":"example.com","role":"text"}},
    {"name":"remove-domain","action":"tap","query":{"text":"Remove","role":"button"}},
    {"name":"row-removed","action":"waitFor","state":"absent","query":{"text":"example.com","role":"text"}},
    {"name":"return-session","action":"tap","query":{"text":"Session","role":"button"}}
  ]
}
