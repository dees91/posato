{
  "version": 1,
  "launch": {
    "terminateExisting": false
  },
  "defaults": {
    "timeoutSeconds": 30
  },
  "onFailure": {
    "screenshot": true,
    "snapshot": true
  },
  "steps": [
    {"name":"open-session","action":"tap","query":{"text":"Session","role":"button"}},
    {"name":"home-inactive","action":"waitFor","state":"exists","query":{"text":"NO SESSION ACTIVE"}},
    {"name":"begin-setup","action":"tap","query":{"text":"Start a session","role":"button"}},
    {"name":"preset","action":"tap","query":{"text":"25 min","role":"button"}},
    {"name":"decrease-minute-1","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-2","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-3","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-4","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-5","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-6","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-7","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-8","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-9","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-10","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-11","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-12","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-13","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-14","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-15","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-16","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-17","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-18","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-19","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"decrease-minute-20","action":"tap","query":{"text":"Decrease Minutes","role":"button"}},
    {"name":"continue-review","action":"tap","query":{"text":"Review session","role":"button"}},
    {"name":"start","action":"tap","query":{"text":"Start this pause","role":"button"}},
    {"name":"active","action":"waitFor","state":"exists","query":{"text":"End session early","role":"button"}},
    {"name":"natural-expiry","action":"waitFor","state":"exists","query":{"text":"NO SESSION ACTIVE"},"timeoutSeconds":400},
    {"name":"expired-shot","action":"screenshot"},
    {"name":"expired-tree","action":"snapshot"},
    {"name":"open-paused-items","action":"tap","query":{"text":"Paused items","role":"button"}},
    {"name":"entry-ready","action":"waitFor","state":"exists","query":{"text":"Search","role":"button"}},
    {"name":"reach-row","action":"scrollTo","query":{"text":"example.com","role":"text","within":{"text":"Saved websites","role":"group"}}},
    {"name":"open-row-menu","action":"tap","query":{"text":"Actions for example.com","role":"button"}},
    {"name":"remove-domain","action":"tap","query":{"text":"Remove","role":"button"}},
    {"name":"row-removed","action":"waitFor","state":"absent","query":{"text":"example.com","role":"text"}},
    {"name":"return-session","action":"tap","query":{"text":"Session","role":"button"}}
  ]
}
