{
  "version": 1,
  "launch": {
    "terminateExisting": false
  },
  "defaults": {
    "timeoutSeconds": 30
  },
  "onFailure": {
    "screenshot": true,
    "snapshot": true
  },
  "steps": [
    {
      "name": "purpose-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Make some space",
        "role": "button"
      }
    },
    {
      "name": "purpose-continue",
      "action": "tap",
      "query": {
        "text": "Make some space",
        "role": "button"
      }
    },
    {
      "name": "privacy-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Your choices stay yours."
      }
    },
    {
      "name": "privacy-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Continue",
        "role": "button"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "privacy-continue",
      "action": "tap",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "icloud-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "icloud-decline",
      "action": "tap",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "action": "waitFor",
      "query": {
        "text": "Set up Posato on this Mac."
      },
      "state": "exists"
    },
    {
      "action": "assert",
      "query": {
        "text": "Set up Posato"
      },
      "state": "disabled"
    },
    {
      "action": "screenshot",
      "name": "onboarding-unified-top"
    },
    {
      "action": "snapshot",
      "name": "onboarding-unified-top"
    },
    {
      "action": "scrollTo",
      "query": {
        "text": "Enable on this Mac"
      }
    },
    {
      "action": "waitFor",
      "query": {
        "text": "Enable on this Mac"
      },
      "state": "exists"
    },
    {
      "action": "screenshot",
      "name": "onboarding-existing-controls"
    },
    {
      "action": "snapshot",
      "name": "onboarding-existing-controls"
    },
    {
      "name": "permission-defer",
      "action": "tap",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "website-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "role": "textField"
      }
    },
    {
      "name": "website-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Not now",
        "role": "button"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "website-skip",
      "action": "tap",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "summary-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Go to Session",
        "role": "button"
      }
    },
    {
      "name": "summary-open-session",
      "action": "tap",
      "query": {
        "text": "Go to Session",
        "role": "button"
      }
    },
    {
      "name": "session-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Paused items",
        "role": "button"
      }
    },
    {
      "action": "waitFor",
      "query": {
        "text": "Finish setup"
      },
      "state": "exists"
    },
    {
      "action": "screenshot",
      "name": "session-finish-setup"
    },
    {
      "action": "snapshot",
      "name": "session-finish-setup"
    },
    {
      "action": "tap",
      "query": {
        "text": "Finish setup"
      }
    },
    {
      "action": "waitFor",
      "query": {
        "text": "Set up Posato"
      },
      "state": "disabled"
    },
    {
      "action": "screenshot",
      "name": "finish-unified-top"
    },
    {
      "action": "snapshot",
      "name": "finish-unified-top"
    },
    {
      "action": "waitFor",
      "query": {
        "text": "Enable on this Mac"
      },
      "state": "exists"
    },
    {
      "action": "screenshot",
      "name": "finish-existing-controls"
    },
    {
      "action": "snapshot",
      "name": "finish-existing-controls"
    },
    {
      "action": "scrollTo",
      "query": {
        "text": "Back to Session"
      }
    },
    {
      "action": "tap",
      "query": {
        "text": "Back to Session"
      }
    },
    {
      "action": "waitFor",
      "query": {
        "text": "Finish setup"
      },
      "state": "exists"
    }
  ]
}
