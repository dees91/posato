{
  "version": 1,
  "launch": {
    "terminateExisting": false
  },
  "defaults": {
    "timeoutSeconds": 30
  },
  "onFailure": {
    "screenshot": true,
    "snapshot": true
  },
  "steps": [
    {
      "name": "purpose-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Make some space",
        "role": "button"
      }
    },
    {
      "name": "purpose-continue",
      "action": "tap",
      "query": {
        "text": "Make some space",
        "role": "button"
      }
    },
    {
      "name": "privacy-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Your choices stay yours."
      }
    },
    {
      "name": "privacy-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Continue",
        "role": "button"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "privacy-continue",
      "action": "tap",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "icloud-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "icloud-decline",
      "action": "tap",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "setup-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Set up Posato on this Mac."
      }
    },
    {
      "action": "screenshot",
      "name": "onboarding-setup-before"
    },
    {
      "name": "setup-start",
      "action": "tap",
      "query": {
        "text": "Set up Posato",
        "role": "button"
      }
    },
    {
      "name": "setup-running",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Setting up…"
      },
      "timeoutSeconds": 60
    },
    {
      "action": "screenshot",
      "name": "onboarding-setup-running"
    },
    {
      "name": "setup-done",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "This Mac is ready."
      },
      "timeoutSeconds": 400
    },
    {
      "action": "screenshot",
      "name": "onboarding-setup-ready"
    },
    {
      "action": "snapshot",
      "name": "onboarding-setup-ready"
    },
    {
      "name": "permission-continue",
      "action": "tap",
      "query": {
        "text": "Continue",
        "role": "button"
      }
    },
    {
      "name": "website-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "role": "textField"
      }
    },
    {
      "name": "website-reveal",
      "action": "scrollTo",
      "query": {
        "text": "Not now",
        "role": "button"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "website-skip",
      "action": "tap",
      "query": {
        "text": "Not now",
        "role": "button"
      }
    },
    {
      "name": "summary-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Go to Session",
        "role": "button"
      }
    },
    {
      "name": "summary-open-session",
      "action": "tap",
      "query": {
        "text": "Go to Session",
        "role": "button"
      }
    },
    {
      "name": "session-ready",
      "action": "waitFor",
      "state": "exists",
      "query": {
        "text": "Pause sets",
        "role": "button"
      }
    },
    {
      "name": "no-finish-setup",
      "action": "assert",
      "state": "absent",
      "query": {
        "text": "Finish setup"
      }
    },
    {
      "action": "screenshot",
      "name": "session-after-setup"
    }
  ]
}
