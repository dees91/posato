{
  "version": 1,
  "launch": { "terminateExisting": false },
  "defaults": { "timeoutSeconds": 20 },
  "onFailure": { "screenshot": true, "snapshot": true },
  "steps": [
    { "name": "open-paused-items", "action": "tap", "query": { "text": "Paused items", "role": "button" } },
    { "name": "apps-tab", "action": "tap", "query": { "textContains": "Apps", "role": "button" } },
    { "name": "choose", "action": "tap", "query": { "text": "Choose apps", "role": "button" } },
    { "name": "search-ready", "action": "waitFor", "state": "exists", "query": { "text": "Search" } },
    { "name": "search", "action": "type", "query": { "text": "Search" }, "text": "Calculator" },
    { "name": "select", "action": "tap", "query": { "textContains": "Calculator, " } },
    { "name": "save", "action": "tap", "query": { "text": "Save", "role": "button" } },
    { "name": "chosen", "action": "waitFor", "state": "exists", "query": { "textContains": "Apps, 1", "role": "button" }, "timeoutSeconds": 20 },
    { "name": "chosen-shot", "action": "screenshot" }
  ]
}
