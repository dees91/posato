CREATE TABLE policy_schema (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  schema_version INTEGER NOT NULL CHECK (schema_version = 1)
);

INSERT INTO policy_schema(singleton, schema_version) VALUES (1, 1);

CREATE TABLE local_policy_metadata (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  revision INTEGER NOT NULL CHECK (revision >= 0)
);

INSERT INTO local_policy_metadata(singleton, revision) VALUES (1, 0);

CREATE TABLE exact_domain_policy (
  canonical_domain TEXT NOT NULL PRIMARY KEY CHECK (
    length(canonical_domain) BETWEEN 3 AND 253
  )
);

selectSchemaVersion:
SELECT COALESCE(schema_version, -1)
FROM policy_schema
WHERE singleton = 1
LIMIT 2;

selectRevision:
SELECT COALESCE(revision, -1)
FROM local_policy_metadata
WHERE singleton = 1
LIMIT 2;

selectDomains:
SELECT COALESCE(canonical_domain, '')
FROM exact_domain_policy
ORDER BY canonical_domain
LIMIT :maximum_row_count;

advanceRevision:
UPDATE local_policy_metadata
SET revision = :next_revision
WHERE singleton = 1 AND revision = :expected_revision;

deleteDomains:
DELETE FROM exact_domain_policy;

insertDomain:
INSERT INTO exact_domain_policy(canonical_domain)
VALUES (:canonical_domain);
