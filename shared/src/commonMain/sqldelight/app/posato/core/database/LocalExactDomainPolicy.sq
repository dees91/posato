CREATE TABLE local_policy_metadata (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  revision INTEGER NOT NULL CHECK (
    typeof(revision) = 'integer' AND revision >= 0
  )
);

INSERT INTO local_policy_metadata(singleton, revision) VALUES (1, 0);

CREATE TABLE exact_domain_policy (
  canonical_domain TEXT NOT NULL PRIMARY KEY CHECK (
    typeof(canonical_domain) = 'text' AND
    length(CAST(canonical_domain AS BLOB)) BETWEEN 3 AND 253
  )
);

CREATE TABLE application_policy (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  canonical_name TEXT NOT NULL CHECK (
    typeof(canonical_name) = 'text' AND
    length(CAST(canonical_name AS BLOB)) BETWEEN 1 AND 80
  )
);

CREATE TABLE www_counterpart_expansion (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1)
);

selectRevision:
SELECT revision
FROM local_policy_metadata
WHERE singleton = 1;

selectDomains:
SELECT canonical_domain
FROM exact_domain_policy
ORDER BY canonical_domain
LIMIT :maximum_row_count;

selectApplicationPolicyNameBytes:
SELECT CAST(canonical_name AS BLOB) AS canonical_name_bytes
FROM application_policy
ORDER BY singleton
LIMIT 2;

advanceRevision:
UPDATE local_policy_metadata
SET revision = :next_revision
WHERE singleton = 1 AND revision = :expected_revision;

deleteDomains:
DELETE FROM exact_domain_policy;

insertDomain:
INSERT INTO exact_domain_policy(canonical_domain)
VALUES (:canonical_domain);

deleteApplicationPolicy:
DELETE FROM application_policy;

insertApplicationPolicy:
INSERT INTO application_policy(singleton, canonical_name)
VALUES (1, :canonical_name);

selectWwwCounterpartExpansion:
SELECT singleton
FROM www_counterpart_expansion
WHERE singleton = 1;

insertWwwCounterpartExpansion:
INSERT OR REPLACE INTO www_counterpart_expansion(singleton)
VALUES (1);
