CREATE TABLE sync_replica_state (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  workspace_id BLOB NOT NULL CHECK (typeof(workspace_id) = 'blob' AND length(workspace_id) = 16),
  transport_epoch_id BLOB NOT NULL CHECK (typeof(transport_epoch_id) = 'blob' AND length(transport_epoch_id) = 16),
  key_epoch_id BLOB NOT NULL CHECK (typeof(key_epoch_id) = 'blob' AND length(key_epoch_id) = 16),
  revision INTEGER NOT NULL CHECK (typeof(revision) = 'integer' AND revision >= 0),
  hlc_physical INTEGER NOT NULL CHECK (typeof(hlc_physical) = 'integer' AND hlc_physical BETWEEN 0 AND 4102444800000),
  hlc_logical INTEGER NOT NULL CHECK (typeof(hlc_logical) = 'integer' AND hlc_logical BETWEEN 0 AND 65535),
  hlc_exhausted INTEGER NOT NULL CHECK (typeof(hlc_exhausted) = 'integer' AND hlc_exhausted IN (0, 1)),
  transport_progress BLOB CHECK (
    transport_progress IS NULL OR
    (typeof(transport_progress) = 'blob' AND length(transport_progress) <= 65536)
  )
);

CREATE TABLE sync_accepted_bundle (
  bundle_id BLOB NOT NULL PRIMARY KEY CHECK (typeof(bundle_id) = 'blob' AND length(bundle_id) = 16),
  bundle_bytes BLOB NOT NULL CHECK (typeof(bundle_bytes) = 'blob' AND length(bundle_bytes) <= 65536),
  operation_bytes BLOB NOT NULL CHECK (typeof(operation_bytes) = 'blob' AND length(operation_bytes) <= 32768),
  author_id BLOB NOT NULL CHECK (typeof(author_id) = 'blob' AND length(author_id) = 16),
  author_sequence INTEGER NOT NULL CHECK (typeof(author_sequence) = 'integer' AND author_sequence > 0),
  public_key BLOB NOT NULL CHECK (typeof(public_key) = 'blob' AND length(public_key) = 32),
  hlc_physical INTEGER NOT NULL CHECK (typeof(hlc_physical) = 'integer' AND hlc_physical BETWEEN 0 AND 4102444800000),
  hlc_logical INTEGER NOT NULL CHECK (typeof(hlc_logical) = 'integer' AND hlc_logical BETWEEN 0 AND 65535),
  UNIQUE(author_id, author_sequence)
);

CREATE TABLE sync_pending_bundle (
  bundle_id BLOB NOT NULL PRIMARY KEY REFERENCES sync_accepted_bundle(bundle_id) ON DELETE CASCADE,
  bundle_bytes BLOB NOT NULL CHECK (typeof(bundle_bytes) = 'blob' AND length(bundle_bytes) <= 65536)
);

CREATE TABLE sync_staged_bundle (
  bundle_id BLOB NOT NULL PRIMARY KEY CHECK (typeof(bundle_id) = 'blob' AND length(bundle_id) = 16),
  bundle_bytes BLOB NOT NULL CHECK (typeof(bundle_bytes) = 'blob' AND length(bundle_bytes) <= 65536),
  operation_bytes BLOB NOT NULL CHECK (typeof(operation_bytes) = 'blob' AND length(operation_bytes) <= 32768),
  author_id BLOB NOT NULL CHECK (typeof(author_id) = 'blob' AND length(author_id) = 16),
  author_sequence INTEGER NOT NULL CHECK (typeof(author_sequence) = 'integer' AND author_sequence > 1),
  public_key BLOB NOT NULL CHECK (typeof(public_key) = 'blob' AND length(public_key) = 32)
);

CREATE INDEX sync_staged_author_sequence
ON sync_staged_bundle(author_id, author_sequence, bundle_id);

CREATE TABLE sync_terminal_expiry (
  session_id BLOB NOT NULL PRIMARY KEY CHECK (typeof(session_id) = 'blob' AND length(session_id) = 16)
);

selectSyncReplicaState:
SELECT singleton, workspace_id, transport_epoch_id, key_epoch_id, revision, hlc_physical, hlc_logical, hlc_exhausted, transport_progress
FROM sync_replica_state;

selectInvalidSyncReplicaBlob:
SELECT 1
FROM sync_replica_state
WHERE CASE
  WHEN typeof(workspace_id) != 'blob' THEN 1
  WHEN length(workspace_id) != 16 THEN 1
  WHEN typeof(transport_epoch_id) != 'blob' THEN 1
  WHEN length(transport_epoch_id) != 16 THEN 1
  WHEN typeof(key_epoch_id) != 'blob' THEN 1
  WHEN length(key_epoch_id) != 16 THEN 1
  WHEN transport_progress IS NOT NULL AND typeof(transport_progress) != 'blob' THEN 1
  WHEN transport_progress IS NOT NULL AND length(transport_progress) > 65536 THEN 1
  ELSE 0
END = 1
UNION ALL
SELECT 1
FROM sync_accepted_bundle
WHERE CASE
  WHEN typeof(bundle_id) != 'blob' THEN 1
  WHEN length(bundle_id) != 16 THEN 1
  WHEN typeof(bundle_bytes) != 'blob' THEN 1
  WHEN length(bundle_bytes) > 65536 THEN 1
  WHEN typeof(operation_bytes) != 'blob' THEN 1
  WHEN length(operation_bytes) > 32768 THEN 1
  WHEN typeof(author_id) != 'blob' THEN 1
  WHEN length(author_id) != 16 THEN 1
  WHEN typeof(public_key) != 'blob' THEN 1
  WHEN length(public_key) != 32 THEN 1
  ELSE 0
END = 1
UNION ALL
SELECT 1
FROM sync_pending_bundle
WHERE CASE
  WHEN typeof(bundle_id) != 'blob' THEN 1
  WHEN length(bundle_id) != 16 THEN 1
  WHEN typeof(bundle_bytes) != 'blob' THEN 1
  WHEN length(bundle_bytes) > 65536 THEN 1
  ELSE 0
END = 1
UNION ALL
SELECT 1
FROM sync_staged_bundle
WHERE CASE
  WHEN typeof(bundle_id) != 'blob' THEN 1
  WHEN length(bundle_id) != 16 THEN 1
  WHEN typeof(bundle_bytes) != 'blob' THEN 1
  WHEN length(bundle_bytes) > 65536 THEN 1
  WHEN typeof(operation_bytes) != 'blob' THEN 1
  WHEN length(operation_bytes) > 32768 THEN 1
  WHEN typeof(author_id) != 'blob' THEN 1
  WHEN length(author_id) != 16 THEN 1
  WHEN typeof(public_key) != 'blob' THEN 1
  WHEN length(public_key) != 32 THEN 1
  ELSE 0
END = 1
UNION ALL
SELECT 1
FROM sync_terminal_expiry
WHERE CASE
  WHEN typeof(session_id) != 'blob' THEN 1
  WHEN length(session_id) != 16 THEN 1
  ELSE 0
END = 1
LIMIT 1;

selectSyncReplicaResidue:
SELECT 1
FROM sync_accepted_bundle
UNION ALL
SELECT 1
FROM sync_pending_bundle
UNION ALL
SELECT 1
FROM sync_staged_bundle
UNION ALL
SELECT 1
FROM sync_terminal_expiry
LIMIT 1;

insertSyncReplicaState:
INSERT INTO sync_replica_state(
  singleton,
  workspace_id,
  transport_epoch_id,
  key_epoch_id,
  revision,
  hlc_physical,
  hlc_logical,
  hlc_exhausted,
  transport_progress
) VALUES (1, :workspace_id, :transport_epoch_id, :key_epoch_id, 0, 0, 0, 0, NULL);

advanceSyncReplicaState:
UPDATE sync_replica_state
SET revision = :next_revision,
    hlc_physical = :hlc_physical,
    hlc_logical = :hlc_logical,
    hlc_exhausted = :hlc_exhausted,
    transport_progress = :transport_progress
WHERE singleton = 1 AND revision = :expected_revision;

selectAcceptedBundles:
SELECT bundle_id, bundle_bytes, operation_bytes, author_id, author_sequence, public_key, hlc_physical, hlc_logical
FROM sync_accepted_bundle
ORDER BY author_id, author_sequence, bundle_id;

selectAcceptedBundleById:
SELECT bundle_id, bundle_bytes, operation_bytes, author_id, author_sequence, public_key, hlc_physical, hlc_logical
FROM sync_accepted_bundle
WHERE bundle_id = :bundle_id;

insertAcceptedBundle:
INSERT INTO sync_accepted_bundle(
  bundle_id,
  bundle_bytes,
  operation_bytes,
  author_id,
  author_sequence,
  public_key,
  hlc_physical,
  hlc_logical
) VALUES (
  :bundle_id,
  :bundle_bytes,
  :operation_bytes,
  :author_id,
  :author_sequence,
  :public_key,
  :hlc_physical,
  :hlc_logical
);

selectPendingBundles:
SELECT bundle_id, bundle_bytes
FROM sync_pending_bundle
ORDER BY rowid;

insertPendingBundle:
INSERT INTO sync_pending_bundle(bundle_id, bundle_bytes)
VALUES (:bundle_id, :bundle_bytes);

selectStagedBundles:
SELECT bundle_id, bundle_bytes, operation_bytes, author_id, author_sequence, public_key
FROM sync_staged_bundle
ORDER BY author_id, author_sequence, bundle_id;

selectStagedBundlesByAuthor:
SELECT bundle_id, bundle_bytes, operation_bytes, author_id, author_sequence, public_key
FROM sync_staged_bundle
WHERE author_id = :author_id
ORDER BY author_sequence, bundle_id;

countStagedBundles:
SELECT count(*)
FROM sync_staged_bundle;

countStagedBundlesByAuthor:
SELECT count(*)
FROM sync_staged_bundle
WHERE author_id = :author_id;

insertStagedBundle:
INSERT INTO sync_staged_bundle(
  bundle_id,
  bundle_bytes,
  operation_bytes,
  author_id,
  author_sequence,
  public_key
) VALUES (
  :bundle_id,
  :bundle_bytes,
  :operation_bytes,
  :author_id,
  :author_sequence,
  :public_key
);

deleteStagedBundle:
DELETE FROM sync_staged_bundle
WHERE bundle_id = :bundle_id;

selectTerminalExpirySessions:
SELECT session_id
FROM sync_terminal_expiry
ORDER BY session_id;

insertTerminalExpiry:
INSERT OR IGNORE INTO sync_terminal_expiry(session_id)
VALUES (:session_id);
