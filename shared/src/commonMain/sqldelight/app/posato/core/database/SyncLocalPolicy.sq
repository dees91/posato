CREATE TABLE sync_policy_intent (
  sequence INTEGER NOT NULL PRIMARY KEY,
  workspace_id BLOB NOT NULL CHECK (typeof(workspace_id) = 'blob' AND length(workspace_id) = 16),
  kind TEXT NOT NULL CHECK (
    typeof(kind) = 'text' AND kind IN ('domain_present', 'domain_absent', 'set_put', 'set_remove', 'set_default')
  ),
  set_id BLOB NOT NULL CHECK (typeof(set_id) = 'blob' AND length(set_id) = 16),
  canonical_domain TEXT CHECK (
    canonical_domain IS NULL OR (
      typeof(canonical_domain) = 'text' AND
      length(CAST(canonical_domain AS BLOB)) BETWEEN 3 AND 253
    )
  ),
  set_name TEXT CHECK (
    set_name IS NULL OR (typeof(set_name) = 'text' AND length(CAST(set_name AS BLOB)) BETWEEN 1 AND 80)
  ),
  CHECK (
    (kind IN ('domain_present', 'domain_absent') AND canonical_domain IS NOT NULL AND set_name IS NULL) OR
    (kind = 'set_put' AND set_name IS NOT NULL AND canonical_domain IS NULL) OR
    (kind IN ('set_remove', 'set_default') AND set_name IS NULL AND canonical_domain IS NULL)
  )
);

CREATE TABLE sync_policy_base (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1)
);

CREATE TABLE sync_policy_base_domain (
  set_id BLOB NOT NULL CHECK (typeof(set_id) = 'blob' AND length(set_id) = 16),
  canonical_domain TEXT NOT NULL CHECK (
    typeof(canonical_domain) = 'text' AND
    length(CAST(canonical_domain AS BLOB)) BETWEEN 3 AND 253
  ),
  PRIMARY KEY (set_id, canonical_domain)
);

CREATE TABLE sync_policy_base_application (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  canonical_name TEXT NOT NULL CHECK (
    typeof(canonical_name) = 'text' AND
    length(CAST(canonical_name AS BLOB)) BETWEEN 1 AND 80
  )
);

selectIntents:
SELECT sequence, workspace_id, kind, set_id, canonical_domain, set_name
FROM sync_policy_intent
ORDER BY sequence;

insertIntent:
INSERT INTO sync_policy_intent(workspace_id, kind, set_id, canonical_domain, set_name)
VALUES (:workspaceId, :kind, :setId, :canonicalDomain, :setName);

deleteIntent:
DELETE FROM sync_policy_intent
WHERE sequence = :sequence;

deleteIntents:
DELETE FROM sync_policy_intent;

selectBaseMarker:
SELECT singleton
FROM sync_policy_base
WHERE singleton = 1;

insertBaseMarker:
INSERT INTO sync_policy_base(singleton)
VALUES (1);

deleteBaseMarker:
DELETE FROM sync_policy_base;

selectBaseDomains:
SELECT set_id, canonical_domain
FROM sync_policy_base_domain
ORDER BY set_id, canonical_domain;

insertBaseDomain:
INSERT INTO sync_policy_base_domain(set_id, canonical_domain)
VALUES (:setId, :canonicalDomain);

deleteBaseDomains:
DELETE FROM sync_policy_base_domain;

selectBaseApplicationName:
SELECT canonical_name
FROM sync_policy_base_application
WHERE singleton = 1;

insertBaseApplication:
INSERT INTO sync_policy_base_application(singleton, canonical_name)
VALUES (1, :canonicalName);

deleteBaseApplication:
DELETE FROM sync_policy_base_application;
