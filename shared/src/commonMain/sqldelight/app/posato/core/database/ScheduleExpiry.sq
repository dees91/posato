CREATE TABLE local_schedule_expiry (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  year INTEGER NOT NULL,
  month INTEGER NOT NULL,
  day INTEGER NOT NULL,
  start_epoch_millis INTEGER NOT NULL,
  end_epoch_millis INTEGER NOT NULL,
  end_minute INTEGER NOT NULL CHECK (end_minute BETWEEN 0 AND 1439),
  notices INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (schedule_id, year, month, day)
);

selectExpiries:
SELECT * FROM local_schedule_expiry;

recordExpiry:
INSERT OR REPLACE INTO local_schedule_expiry(schedule_id, year, month, day, start_epoch_millis, end_epoch_millis, end_minute, notices)
SELECT :scheduleId, :year, :month, :day, :startEpochMillis, :endEpochMillis, :endMinute, :notices
WHERE NOT EXISTS (
  SELECT 1 FROM local_schedule_expiry
  WHERE schedule_id = :scheduleId AND year = :year AND month = :month AND day = :day
    AND end_epoch_millis >= :endEpochMillis
);

deleteExpiredPin:
DELETE FROM local_schedule_pin
WHERE schedule_id = :scheduleId AND year = :year AND month = :month AND day = :day
  AND (resumed_after IS NULL OR resumed_after < :endEpochMillis);

deleteExpiriesForSchedule:
DELETE FROM local_schedule_expiry WHERE schedule_id = :scheduleId;
