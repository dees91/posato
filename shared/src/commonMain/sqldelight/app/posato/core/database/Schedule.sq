CREATE TABLE local_schedule (
  schedule_id BLOB NOT NULL PRIMARY KEY CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  name TEXT NOT NULL CHECK (typeof(name) = 'text' AND length(CAST(name AS BLOB)) BETWEEN 1 AND 80),
  weekdays INTEGER NOT NULL CHECK (typeof(weekdays) = 'integer' AND weekdays BETWEEN 1 AND 127),
  start_minute INTEGER NOT NULL CHECK (typeof(start_minute) = 'integer' AND start_minute BETWEEN 0 AND 1439),
  end_minute INTEGER NOT NULL CHECK (typeof(end_minute) = 'integer' AND end_minute BETWEEN 0 AND 1439),
  enabled INTEGER NOT NULL CHECK (typeof(enabled) = 'integer' AND enabled IN (0, 1)),
  refused INTEGER NOT NULL DEFAULT 0 CHECK (typeof(refused) = 'integer' AND refused IN (0, 1)),
  set_id BLOB NOT NULL CHECK (typeof(set_id) = 'blob' AND length(set_id) = 16),
  CHECK (start_minute <> end_minute)
);

CREATE TABLE local_schedule_fact (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  kind TEXT NOT NULL CHECK (typeof(kind) = 'text' AND kind IN ('skip', 'end')),
  year INTEGER NOT NULL CHECK (typeof(year) = 'integer' AND year BETWEEN 2000 AND 2100),
  month INTEGER NOT NULL CHECK (typeof(month) = 'integer' AND month BETWEEN 1 AND 12),
  day INTEGER NOT NULL CHECK (typeof(day) = 'integer' AND day BETWEEN 1 AND 31),
  PRIMARY KEY (schedule_id, kind, year, month, day)
);

CREATE TABLE local_schedule_pin (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  year INTEGER NOT NULL CHECK (typeof(year) = 'integer' AND year BETWEEN 2000 AND 2100),
  month INTEGER NOT NULL CHECK (typeof(month) = 'integer' AND month BETWEEN 1 AND 12),
  day INTEGER NOT NULL CHECK (typeof(day) = 'integer' AND day BETWEEN 1 AND 31),
  start_epoch_millis INTEGER NOT NULL CHECK (
    typeof(start_epoch_millis) = 'integer' AND start_epoch_millis BETWEEN 0 AND 4102444800000
  ),
  notices INTEGER NOT NULL DEFAULT 0 CHECK (typeof(notices) = 'integer' AND notices BETWEEN 0 AND 255),
  PRIMARY KEY (schedule_id, year, month, day)
);

CREATE TABLE sync_schedule_intent (
  sequence INTEGER NOT NULL PRIMARY KEY,
  workspace_id BLOB NOT NULL CHECK (typeof(workspace_id) = 'blob' AND length(workspace_id) = 16),
  kind TEXT NOT NULL CHECK (typeof(kind) = 'text' AND kind IN ('put', 'remove', 'skip', 'end', 'break', 'break_end')),
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  name TEXT CHECK (name IS NULL OR (typeof(name) = 'text' AND length(CAST(name AS BLOB)) BETWEEN 1 AND 80)),
  weekdays INTEGER CHECK (weekdays IS NULL OR (typeof(weekdays) = 'integer' AND weekdays BETWEEN 1 AND 127)),
  start_minute INTEGER CHECK (start_minute IS NULL OR (typeof(start_minute) = 'integer' AND start_minute BETWEEN 0 AND 1439)),
  end_minute INTEGER CHECK (end_minute IS NULL OR (typeof(end_minute) = 'integer' AND end_minute BETWEEN 0 AND 1439)),
  enabled INTEGER CHECK (enabled IS NULL OR (typeof(enabled) = 'integer' AND enabled IN (0, 1))),
  year INTEGER CHECK (year IS NULL OR (typeof(year) = 'integer' AND year BETWEEN 2000 AND 2100)),
  month INTEGER CHECK (month IS NULL OR (typeof(month) = 'integer' AND month BETWEEN 1 AND 12)),
  day INTEGER CHECK (day IS NULL OR (typeof(day) = 'integer' AND day BETWEEN 1 AND 31)),
  author_year INTEGER CHECK (author_year IS NULL OR (typeof(author_year) = 'integer' AND author_year BETWEEN 2000 AND 2100)),
  author_month INTEGER CHECK (author_month IS NULL OR (typeof(author_month) = 'integer' AND author_month BETWEEN 1 AND 12)),
  author_day INTEGER CHECK (author_day IS NULL OR (typeof(author_day) = 'integer' AND author_day BETWEEN 1 AND 31)),
  set_id BLOB NOT NULL CHECK (typeof(set_id) = 'blob' AND length(set_id) = 16),
  break_start_epoch_millis INTEGER CHECK (
    break_start_epoch_millis IS NULL OR (
      typeof(break_start_epoch_millis) = 'integer' AND break_start_epoch_millis BETWEEN 0 AND 4102444800000
    )
  ),
  break_minutes INTEGER CHECK (break_minutes IS NULL OR (typeof(break_minutes) = 'integer' AND break_minutes IN (5, 10, 15))),
  CHECK (
    (
      kind = 'put' AND name IS NOT NULL AND weekdays IS NOT NULL AND start_minute IS NOT NULL AND end_minute IS NOT NULL AND
      enabled IS NOT NULL AND start_minute <> end_minute AND year IS NULL AND month IS NULL AND day IS NULL AND
      author_year IS NULL AND author_month IS NULL AND author_day IS NULL AND
      break_start_epoch_millis IS NULL AND break_minutes IS NULL
    ) OR (
      kind = 'remove' AND name IS NULL AND weekdays IS NULL AND start_minute IS NULL AND end_minute IS NULL AND
      enabled IS NULL AND year IS NULL AND month IS NULL AND day IS NULL AND
      author_year IS NULL AND author_month IS NULL AND author_day IS NULL AND
      break_start_epoch_millis IS NULL AND break_minutes IS NULL
    ) OR (
      kind IN ('skip', 'end', 'break_end') AND name IS NULL AND weekdays IS NULL AND start_minute IS NULL AND end_minute IS NULL AND
      enabled IS NULL AND year IS NOT NULL AND month IS NOT NULL AND day IS NOT NULL AND
      author_year IS NOT NULL AND author_month IS NOT NULL AND author_day IS NOT NULL AND
      break_start_epoch_millis IS NULL AND break_minutes IS NULL
    ) OR (
      kind = 'break' AND name IS NULL AND weekdays IS NULL AND start_minute IS NULL AND end_minute IS NULL AND
      enabled IS NULL AND year IS NOT NULL AND month IS NOT NULL AND day IS NOT NULL AND
      author_year IS NOT NULL AND author_month IS NOT NULL AND author_day IS NOT NULL AND
      break_start_epoch_millis IS NOT NULL AND break_minutes IS NOT NULL
    )
  )
);

CREATE TABLE local_schedule_break (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  year INTEGER NOT NULL CHECK (typeof(year) = 'integer' AND year BETWEEN 2000 AND 2100),
  month INTEGER NOT NULL CHECK (typeof(month) = 'integer' AND month BETWEEN 1 AND 12),
  day INTEGER NOT NULL CHECK (typeof(day) = 'integer' AND day BETWEEN 1 AND 31),
  start_epoch_millis INTEGER NOT NULL CHECK (
    typeof(start_epoch_millis) = 'integer' AND start_epoch_millis BETWEEN 0 AND 4102444800000
  ),
  minutes INTEGER NOT NULL CHECK (typeof(minutes) = 'integer' AND minutes IN (5, 10, 15)),
  taken_here INTEGER NOT NULL DEFAULT 0 CHECK (typeof(taken_here) = 'integer' AND taken_here IN (0, 1)),
  PRIMARY KEY (schedule_id, year, month, day)
);

CREATE TABLE local_schedule_break_end (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  year INTEGER NOT NULL CHECK (typeof(year) = 'integer' AND year BETWEEN 2000 AND 2100),
  month INTEGER NOT NULL CHECK (typeof(month) = 'integer' AND month BETWEEN 1 AND 12),
  day INTEGER NOT NULL CHECK (typeof(day) = 'integer' AND day BETWEEN 1 AND 31),
  PRIMARY KEY (schedule_id, year, month, day)
);

-- A break this device saw end: it never releases here again, whatever the clock says later.
CREATE TABLE local_schedule_break_over (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  year INTEGER NOT NULL CHECK (typeof(year) = 'integer' AND year BETWEEN 2000 AND 2100),
  month INTEGER NOT NULL CHECK (typeof(month) = 'integer' AND month BETWEEN 1 AND 12),
  day INTEGER NOT NULL CHECK (typeof(day) = 'integer' AND day BETWEEN 1 AND 31),
  PRIMARY KEY (schedule_id, year, month, day)
);

CREATE TABLE sync_pause_sets_enabled (
  workspace_id BLOB NOT NULL PRIMARY KEY CHECK (typeof(workspace_id) = 'blob' AND length(workspace_id) = 16)
);
CREATE TABLE sync_schedule_seed (
  workspace_id BLOB NOT NULL PRIMARY KEY CHECK (typeof(workspace_id) = 'blob' AND length(workspace_id) = 16)
);

selectSchedules:
SELECT schedule_id, name, weekdays, start_minute, end_minute, enabled, refused, set_id
FROM local_schedule
ORDER BY schedule_id;

countLiveSchedules:
SELECT count(*) FROM local_schedule WHERE refused = 0;

upsertSchedule:
INSERT OR REPLACE INTO local_schedule(schedule_id, name, weekdays, start_minute, end_minute, enabled, refused, set_id)
VALUES (:scheduleId, :name, :weekdays, :startMinute, :endMinute, :enabled, :refused, :setId);

-- Without a shared workspace no cap refuses anything, so refused plans rejoin up to the local cap of 10.
promoteRefusedSchedules:
UPDATE local_schedule SET refused = 0
WHERE schedule_id IN (
  SELECT schedule_id FROM local_schedule WHERE refused = 1 ORDER BY schedule_id
  LIMIT max(0, 10 - (SELECT count(*) FROM local_schedule WHERE refused = 0))
);

deleteSchedule:
DELETE FROM local_schedule WHERE schedule_id = :scheduleId;

deleteAllSchedules:
DELETE FROM local_schedule;

selectFacts:
SELECT schedule_id, kind, year, month, day
FROM local_schedule_fact
ORDER BY schedule_id, kind, year, month, day;

insertFact:
INSERT OR IGNORE INTO local_schedule_fact(schedule_id, kind, year, month, day)
VALUES (:scheduleId, :kind, :year, :month, :day);

deleteFactsForSchedule:
DELETE FROM local_schedule_fact WHERE schedule_id = :scheduleId;

selectPins:
SELECT schedule_id, year, month, day, start_epoch_millis, notices
FROM local_schedule_pin;

upsertPin:
INSERT OR REPLACE INTO local_schedule_pin(schedule_id, year, month, day, start_epoch_millis, notices)
VALUES (:scheduleId, :year, :month, :day, :startEpochMillis, :notices);

insertPinIfAbsent:
INSERT OR IGNORE INTO local_schedule_pin(schedule_id, year, month, day, start_epoch_millis, notices)
VALUES (:scheduleId, :year, :month, :day, :startEpochMillis, 0);

addPinNotices:
UPDATE local_schedule_pin SET notices = notices | :bits
WHERE schedule_id = :scheduleId AND year = :year AND month = :month AND day = :day;

-- A pin lives while its occurrence runs; one left by a quit ends within a day.
countRunningPins:
SELECT count(*) FROM local_schedule_pin
WHERE start_epoch_millis <= :nowEpochMillis AND start_epoch_millis > :nowEpochMillis - 86400000;

deletePin:
DELETE FROM local_schedule_pin
WHERE schedule_id = :scheduleId AND year = :year AND month = :month AND day = :day;

selectScheduleIntents:
SELECT sequence, workspace_id, kind, schedule_id, name, weekdays, start_minute, end_minute, enabled, year, month, day,
  author_year, author_month, author_day, set_id, break_start_epoch_millis, break_minutes
FROM sync_schedule_intent
ORDER BY sequence;

insertScheduleIntent:
INSERT INTO sync_schedule_intent(
  workspace_id, kind, schedule_id, name, weekdays, start_minute, end_minute, enabled, year, month, day,
  author_year, author_month, author_day, set_id, break_start_epoch_millis, break_minutes
)
VALUES (
  :workspaceId, :kind, :scheduleId, :name, :weekdays, :startMinute, :endMinute, :enabled, :year, :month, :day,
  :authorYear, :authorMonth, :authorDay, :setId, :breakStartEpochMillis, :breakMinutes
);

deleteScheduleIntent:
DELETE FROM sync_schedule_intent WHERE sequence = :sequence;

deleteAllScheduleIntents:
DELETE FROM sync_schedule_intent;

selectSeed:
SELECT workspace_id FROM sync_schedule_seed WHERE workspace_id = :workspaceId;

insertSeed:
INSERT OR IGNORE INTO sync_schedule_seed(workspace_id) VALUES (:workspaceId);

deleteAllSeeds:
DELETE FROM sync_schedule_seed;

deletePinsForSchedule:
DELETE FROM local_schedule_pin WHERE schedule_id = :scheduleId;

selectPauseSetsEnabled:
SELECT workspace_id
FROM sync_pause_sets_enabled
WHERE workspace_id = :workspaceId;

insertPauseSetsEnabled:
INSERT OR IGNORE INTO sync_pause_sets_enabled(workspace_id)
VALUES (:workspaceId);

deleteAllPauseSetsEnabled:
DELETE FROM sync_pause_sets_enabled;

selectPinsRunningAt:
SELECT schedule_id, year, month, day FROM local_schedule_pin
WHERE start_epoch_millis <= :nowEpochMillis AND start_epoch_millis > :nowEpochMillis - 86400000;

selectBreaks:
SELECT schedule_id, year, month, day, start_epoch_millis, minutes
FROM local_schedule_break;

insertBreak:
INSERT OR IGNORE INTO local_schedule_break(schedule_id, year, month, day, start_epoch_millis, minutes)
VALUES (:scheduleId, :year, :month, :day, :startEpochMillis, :minutes);

-- This device's own press keeps the earliest start it knows and marks the break as taken here.
lowerBreakStart:
UPDATE local_schedule_break SET
  minutes = CASE WHEN start_epoch_millis > :startEpochMillis THEN :minutes ELSE minutes END,
  start_epoch_millis = min(start_epoch_millis, :startEpochMillis),
  taken_here = 1
WHERE schedule_id = :scheduleId AND year = :year AND month = :month AND day = :day;

-- The shared winner replaces a local fact that starts at the same time or later, so replicas agree on ties.
takeSharedBreak:
UPDATE local_schedule_break SET start_epoch_millis = :startEpochMillis, minutes = :minutes
WHERE schedule_id = :scheduleId AND year = :year AND month = :month AND day = :day AND start_epoch_millis >= :startEpochMillis;

deleteBreaksForSchedule:
DELETE FROM local_schedule_break WHERE schedule_id = :scheduleId;

selectBreakEnds:
SELECT schedule_id, year, month, day FROM local_schedule_break_end;

insertBreakEnd:
INSERT OR IGNORE INTO local_schedule_break_end(schedule_id, year, month, day)
VALUES (:scheduleId, :year, :month, :day);

deleteBreakEndsForSchedule:
DELETE FROM local_schedule_break_end WHERE schedule_id = :scheduleId;

selectBreaksOver:
SELECT schedule_id, year, month, day FROM local_schedule_break_over;

insertBreakOver:
INSERT OR IGNORE INTO local_schedule_break_over(schedule_id, year, month, day)
VALUES (:scheduleId, :year, :month, :day);

deleteBreaksOverBefore:
DELETE FROM local_schedule_break_over WHERE year * 10000 + month * 100 + day < :dateValue;

deleteBreaksOverForSchedule:
DELETE FROM local_schedule_break_over WHERE schedule_id = :scheduleId;

-- After unlinking, a break received from the workspace ends here at once; one taken here keeps running.
endReceivedBreaks:
INSERT OR IGNORE INTO local_schedule_break_over(schedule_id, year, month, day)
SELECT schedule_id, year, month, day FROM local_schedule_break WHERE taken_here = 0;
