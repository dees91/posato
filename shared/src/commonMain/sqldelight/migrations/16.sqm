-- TARGETS-013: a website's window rule per pause set, and kind 22 in the policy intent queue.
CREATE TABLE local_pause_set_window (
  set_id BLOB NOT NULL CHECK (typeof(set_id) = 'blob' AND length(set_id) = 16),
  canonical_domain TEXT NOT NULL CHECK (
    typeof(canonical_domain) = 'text' AND
    length(CAST(canonical_domain AS BLOB)) BETWEEN 3 AND 253
  ),
  period_minutes INTEGER NOT NULL CHECK (typeof(period_minutes) = 'integer' AND period_minutes IN (30, 60, 120)),
  length_minutes INTEGER NOT NULL CHECK (typeof(length_minutes) = 'integer' AND length_minutes IN (5, 10, 15)),
  PRIMARY KEY (set_id, canonical_domain)
);

CREATE TABLE sync_policy_intent_v2 (
  sequence INTEGER NOT NULL PRIMARY KEY,
  workspace_id BLOB NOT NULL CHECK (typeof(workspace_id) = 'blob' AND length(workspace_id) = 16),
  kind TEXT NOT NULL CHECK (
    typeof(kind) = 'text' AND
    kind IN ('domain_present', 'domain_absent', 'set_put', 'set_remove', 'set_default', 'set_window')
  ),
  set_id BLOB NOT NULL CHECK (typeof(set_id) = 'blob' AND length(set_id) = 16),
  canonical_domain TEXT CHECK (
    canonical_domain IS NULL OR (
      typeof(canonical_domain) = 'text' AND
      length(CAST(canonical_domain AS BLOB)) BETWEEN 3 AND 253
    )
  ),
  set_name TEXT CHECK (
    set_name IS NULL OR (typeof(set_name) = 'text' AND length(CAST(set_name AS BLOB)) BETWEEN 1 AND 80)
  ),
  window_period INTEGER CHECK (window_period IS NULL OR (typeof(window_period) = 'integer' AND window_period IN (30, 60, 120))),
  window_length INTEGER CHECK (window_length IS NULL OR (typeof(window_length) = 'integer' AND window_length IN (5, 10, 15))),
  CHECK (
    (
      kind IN ('domain_present', 'domain_absent') AND canonical_domain IS NOT NULL AND set_name IS NULL AND
      window_period IS NULL AND window_length IS NULL
    ) OR (
      kind = 'set_put' AND set_name IS NOT NULL AND canonical_domain IS NULL AND window_period IS NULL AND window_length IS NULL
    ) OR (
      kind IN ('set_remove', 'set_default') AND set_name IS NULL AND canonical_domain IS NULL AND
      window_period IS NULL AND window_length IS NULL
    ) OR (
      kind = 'set_window' AND canonical_domain IS NOT NULL AND set_name IS NULL AND
      (window_period IS NULL) = (window_length IS NULL)
    )
  )
);

INSERT INTO sync_policy_intent_v2(sequence, workspace_id, kind, set_id, canonical_domain, set_name)
SELECT sequence, workspace_id, kind, set_id, canonical_domain, set_name
FROM sync_policy_intent;

DROP TABLE sync_policy_intent;

ALTER TABLE sync_policy_intent_v2 RENAME TO sync_policy_intent;
