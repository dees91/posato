DELETE FROM local_schedule_terminal;
ALTER TABLE local_schedule_pin ADD COLUMN resumed_after INTEGER;

CREATE TABLE local_schedule_expiry (
  schedule_id BLOB NOT NULL CHECK (typeof(schedule_id) = 'blob' AND length(schedule_id) = 16),
  year INTEGER NOT NULL,
  month INTEGER NOT NULL,
  day INTEGER NOT NULL,
  start_epoch_millis INTEGER NOT NULL,
  end_epoch_millis INTEGER NOT NULL,
  end_minute INTEGER NOT NULL CHECK (end_minute BETWEEN 0 AND 1439),
  notices INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (schedule_id, year, month, day)
);
