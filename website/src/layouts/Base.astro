---
import iconUrl from "../../../docs/design/app-icon/forest.svg?url";
import "../styles/site.css";

interface Props {
  title?: string;
  description: string;
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
const pageTitle = title ? `${title} - Posato` : "Posato - Pause. Then choose.";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href={iconUrl} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="identity" href="/"><span class="mark" aria-hidden="true"></span>posato</a>
      <nav aria-label="Site">
        <a href="/privacy/">Privacy</a>
        <a href="/support/">Support</a>
        <a class="repository" href="https://github.com/dees91/posato" aria-label="Posato on GitHub">
          <svg class="github-mark" viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Footer">
        <a href="/">Posato</a>
        <a href="/limits/">Limits</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/support/">Support</a>
      </nav>
      <p>Copyright 2026 Piotr Krawczyk and Posato contributors. Open source under the Apache License 2.0.</p>
    </footer>
  </body>
</html>
