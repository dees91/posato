---
import iconUrl from "../../../docs/design/app-icon/forest.svg?url";
import "../styles/site.css";

interface Props {
  title?: string;
  description: string;
  indexable?: boolean;
}

type Chrome = {
  languageName: string;
  homeTitle: string;
  privacy: string;
  support: string;
  limits: string;
  privacyPolicy: string;
  navigation: string;
  footer: string;
  languages: string;
  github: string;
  copyright: string;
};

const english: Chrome = {
  languageName: "English",
  homeTitle: "Posato - A little space. For what matters.",
  privacy: "Privacy",
  support: "Support",
  limits: "Limits",
  privacyPolicy: "Privacy policy",
  navigation: "Site",
  footer: "Footer",
  languages: "Languages",
  github: "Posato on GitHub",
  copyright: "Copyright 2026 Piotr Krawczyk and Posato contributors. Open source under the Apache License 2.0.",
};

// Each translation keeps its labels in pages/<code>/chrome.json. /<code>/ is its home, and every
// other translated URL keeps the English path after that prefix.
const chromes = import.meta.glob<Chrome>("../pages/*/chrome.json", { eager: true, import: "default" });
const languages = [
  { code: "en", labels: english },
  ...Object.entries(chromes)
    .map(([file, labels]) => ({ code: file.split("/").at(-2) ?? "", labels }))
    .sort((a, b) => a.code.localeCompare(b.code)),
];

const { title, description, indexable = true } = Astro.props;

function withTrailingSlash(pathname: string): string {
  let path = pathname || "/";
  if (path.endsWith(".html")) {
    path = path.slice(0, -".html".length);
  }
  if (!path.startsWith("/")) {
    path = `/${path}`;
  }
  if (!path.endsWith("/")) {
    path = `${path}/`;
  }
  return path;
}

const prefix = (code: string) => (code === "en" ? "" : `/${code}`);
const path = withTrailingSlash(Astro.url.pathname);
const current = languages.find(({ code }) => code !== "en" && path.startsWith(`/${code}/`)) ?? languages[0];
const englishPath = path.slice(prefix(current.code).length);
const labels = current.labels;
const root = prefix(current.code);
const home = `${root}/`;
const pageTitle = title ? `${title} - Posato` : labels.homeTitle;
const canonical = new URL(path, Astro.site);
const alternates = languages.map(({ code, labels }) => ({
  code,
  name: labels.languageName,
  path: `${prefix(code)}${englishPath}`,
}));
---

<!doctype html>
<html lang={current.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {alternates.map(({ code, path }) => <link rel="alternate" hreflang={code} href={new URL(path, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(englishPath, Astro.site)} />
    <link rel="icon" href={iconUrl} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="identity" href={home}><span class="mark" aria-hidden="true"></span>posato</a>
      <nav aria-label={labels.navigation}>
        <a href={`${root}/privacy/`}>{labels.privacy}</a>
        <a href={`${root}/support/`}>{labels.support}</a>
        <a class="repository" href="https://github.com/dees91/posato" aria-label={labels.github}>
          <svg class="github-mark" viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label={labels.footer}>
        <a href={home}>Posato</a>
        <a href={`${root}/limits/`}>{labels.limits}</a>
        <a href={`${root}/privacy/`}>{labels.privacyPolicy}</a>
        <a href={`${root}/support/`}>{labels.support}</a>
      </nav>
      <nav class="languages" aria-label={labels.languages}>
        {
          alternates.map(({ code, name, path }) =>
            code === current.code ? (
              <span lang={code} aria-current="page">
                {name}
              </span>
            ) : (
              <a href={path} lang={code} hreflang={code}>
                {name}
              </a>
            ),
          )
        }
      </nav>
      <p>
        {labels.copyright}
      </p>
    </footer>
  </body>
</html>
